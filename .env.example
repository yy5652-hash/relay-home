# Everything here is optional. Without any of it Relay Home runs with the built-in scripted model.
PORT=4317
HOST=127.0.0.1
# Comma-separated host names the server may be reached under when it is not on localhost (DNS-rebinding protection).
RELAY_ALLOWED_HOSTS=
# Where households and the signing secret are kept.
RELAY_DATA_DIR=.data

# A hosted model for the agent. Pick one.
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
